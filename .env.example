# ============================================================
# Bulan — mail endpoint configuration
#
# ►► NEVER COMMIT THE REAL VALUES. ◄◄
# This file documents the variables; it holds no secrets.
#
# In production these live in Netlify:
#   Site configuration → Environment variables → Add a variable
# For local testing with `netlify dev`, copy this file to `.env`
# (which .gitignore already excludes) and fill it in.
# ============================================================

# --- SMTP transport -----------------------------------------
# Google Workspace / Gmail. Requires 2-Step Verification on the
# account, then an App password:
#   Google Account → Security → 2-Step Verification → App passwords
# Use that 16-character value below, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@bulan.co.za
SMTP_PASS=xxxxxxxxxxxxxxxx

# --- Addressing ----------------------------------------------
# MAIL_FROM must be a mailbox on your own domain. Sending "from" the
# visitor's address would fail SPF and DKIM and land the mail in spam;
# the function puts the visitor in Reply-To instead, so hitting reply
# in your inbox still goes to them.
MAIL_FROM="Bulan website <hello@bulan.co.za>"
MAIL_TO=hello@bulan.co.za

# --- Behaviour ------------------------------------------------
# Send the visitor an instant delivery receipt. Deliberately false:
# the site promises "a considered human reply, not an auto-responder",
# and a templated reply within seconds undercuts that. Turn it on only
# if you decide the receipt is worth the contradiction.
MAIL_ACK=false

# Reject POSTs from anywhere but your own site. Set this to your live
# origin once the domain is pointed. Leave blank to skip the check
# (useful while testing from localhost).
ALLOWED_ORIGIN=https://www.bulan.co.za

# Extension-less URLs, in case anyone links to them that way.

/services/software-development   /services/software-development.html   301
/services/software-testing       /services/software-testing.html       301
/services/cyber-security         /services/cyber-security.html         301
/services/ai-automation          /services/ai-automation.html          301
/services                        /services.html                        301
/approach                        /approach.html                        301
/industries                      /industries.html                      301
/about                           /about.html                           301
/insights                        /insights.html                        301
/contact                         /contact.html                         301
/quote                           /quote.html                           301
/privacy                         /legal/privacy.html                   301
/paia                            /legal/paia.html                      301
/terms                           /legal/terms.html                     301
/cookies                         /legal/cookies.html                   301
/security                        /legal/vulnerability-disclosure.html  301

# The whole folder is published (publish = "."), so repo-only files would
# otherwise be downloadable. None hold secrets, but the README and brand
# notes are internal and there is no reason to serve them.
# The "!" forces the rule: without it Netlify serves any file that exists
# and only applies a redirect when nothing is there to shadow it.
/netlify/*            /404.html   404!
/tests/*              /404.html   404!
/scripts/*            /404.html   404!
/node_modules/*       /404.html   404!
/README.md            /404.html   404!
/BRAND.md             /404.html   404!
/package.json         /404.html   404!
/package-lock.json    /404.html   404!
/netlify.toml         /404.html   404!
/.env.example         /404.html   404!
/.gitignore           /404.html   404!
/serve.ps1            /404.html   404!
/_headers             /404.html   404!
/_redirects           /404.html   404!

# Catch-all 404
/*   /404.html   404

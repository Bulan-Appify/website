# ============================================================
# Bulan — mail settings
#
# LOCAL:   copy this file to .env, change the lines marked ◄ CHANGE,
#          then run  npm run mail:check  and  npm run dev
# NETLIFY: Site configuration → Environment variables →
#          Add a variable → "Import from a .env file", and paste
#          the filled-in lines. Then trigger a new deploy.
#
# .env is in .gitignore. Never commit the real values.
# ============================================================

# --- Gmail login ---------------------------------------------
# SMTP_USER is the Gmail address that sends the mail.
# SMTP_PASS is a Gmail APP PASSWORD, not your normal password:
#   Google Account → Security → 2-Step Verification (turn on)
#   → App passwords → create "Bulan website" → copy the 16 letters.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# ◄ CHANGE the next two lines (the app password may keep its spaces)
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcdefghijklmnop

# --- Addresses -----------------------------------------------
# MAIL_FROM must use the SAME address as SMTP_USER, or Gmail
# rewrites it. The visitor goes in Reply-To, so Reply still
# reaches them.
# ◄ CHANGE: the same address as SMTP_USER
MAIL_FROM="Bulan website <yourname@gmail.com>"
# ◄ CHANGE: where new briefs and quotation requests land
MAIL_TO=yourname@gmail.com

# --- Behaviour -----------------------------------------------
# Send the visitor a receipt. true unless set to false.
MAIL_ACK=true

# Only accept form posts from this site. Leave EMPTY while testing:
# localhost and Netlify preview links would be refused. At launch set
#   ALLOWED_ORIGIN=https://www.bulan.co.za
ALLOWED_ORIGIN=
